# Copy to .env and adjust as needed. docker-compose reads this file automatically.
# Every value below already has a default in docker-compose.yml, so .env is optional.
#
# .env is gitignored. Never commit real AWS credentials.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=alg_user
POSTGRES_PASSWORD=alg_password
POSTGRES_DB=alg_db

# --- AI provider ------------------------------------------------------------
# "mock"    = offline fixture, no AWS account needed
# "bedrock" = real Amazon Bedrock call
AI_PROVIDER=mock
MOCK_AI_LATENCY_MS=600

# --- AWS / Amazon Bedrock ---------------------------------------------------
# Required only when AI_PROVIDER=bedrock.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary/STS credentials.
AWS_SESSION_TOKEN=

# Newer Claude models are invoked through a cross-region inference profile,
# hence the "us." prefix. Swap it (eu. / jp. / au.) to match your region.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=1500
BEDROCK_TEMPERATURE=0.0
BEDROCK_READ_TIMEOUT_SECONDS=45
