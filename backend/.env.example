# Copy to backend/.env for local (non-Docker) runs.
# In Docker, docker-compose passes these through instead -- environment
# variables always win over this file.
#
# backend/.env is gitignored and excluded from the Docker image.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://alg_user:alg_password@127.0.0.1:5432/alg_db

# --- CORS -------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI provider ------------------------------------------------------------
# "mock"    = offline fixture, no credentials needed
# "bedrock" = real Amazon Bedrock call
AI_PROVIDER=mock
MOCK_AI_LATENCY_MS=600

# --- AWS / Amazon Bedrock ---------------------------------------------------
# Leave the keys blank to use ~/.aws/credentials, SSO or an IAM role instead.
# NEVER commit real values.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary/STS credentials.
AWS_SESSION_TOKEN=

# Newer Claude models are invoked through a cross-region inference profile,
# hence the "us." prefix. Change the prefix (eu. / jp. / au.) to match your
# region, or use a plain model id for in-region on-demand access.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=1500
BEDROCK_TEMPERATURE=0.0
BEDROCK_READ_TIMEOUT_SECONDS=45
